# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.
OPENCTI_ADMIN_EMAIL=admin@example.local
OPENCTI_ADMIN_PASSWORD=change-me
OPENCTI_ADMIN_TOKEN=generate-a-uuid
ELASTIC_MEMORY_SIZE=4G

# Connector (mỗi connector một tài khoản [C] riêng trong OpenCTI)
CONNECTOR_ALIENVAULT_ID=generate-a-uuid
CONNECTOR_ALIENVAULT_TOKEN=

# Nguồn dữ liệu
OTX_API_KEY=
ABUSECH_AUTH_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
NVD_API_KEY=

# LLM cho extractor (chỉ dữ liệu TLP:CLEAR/GREEN)
GEMINI_API_KEY=

# Hermes / Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
