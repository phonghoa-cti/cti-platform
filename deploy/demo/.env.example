# Sao chép thành .env chỉ trên máy lab. Không commit .env hoặc giá trị thật.
# Các ô trống là bắt buộc; `docker compose config` sẽ từ chối nếu còn trống.

OPENCTI_PORT=8080
ELASTIC_MEMORY_SIZE=2g

OPENCTI_ADMIN_EMAIL=
OPENCTI_ADMIN_PASSWORD=
# UUIDv4 riêng, sinh ngẫu nhiên cho lab mới; không dùng lại connector ID/token.
OPENCTI_ADMIN_TOKEN=
# Base64 của ít nhất 32 byte ngẫu nhiên sau khi decode.
OPENCTI_ENCRYPTION_KEY=
OPENCTI_HEALTHCHECK_ACCESS_KEY=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# Chỉ cần khi ghép compose.mitre.yml. ID là UUIDv4 riêng; token do OpenCTI cấp, khác ID/admin, không ép UUID.
CONNECTOR_MITRE_ID=
CONNECTOR_MITRE_TOKEN=

# Chỉ cần khi ghép compose.import.yml. ID là UUIDv4 riêng; token do OpenCTI cấp, khác ID/admin, không ép UUID.
CONNECTOR_IMPORT_FILE_STIX_ID=
CONNECTOR_IMPORT_FILE_STIX_TOKEN=
